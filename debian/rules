#!/usr/bin/make -f

export DH_VIRTUALENV_INSTALL_ROOT=/opt/venvs

%:
	dh $@ --with python-virtualenv

override_dh_virtualenv:
	dh_virtualenv --python /usr/bin/python3 \
	              --use-system-packages \
	              --preinstall pip \
	              --preinstall setuptools \
	              --preinstall wheel

# Pillow's repaired ARM wheels have an ELF section layout dwz cannot rewrite.
override_dh_dwz:
	dh_dwz -X/site-packages/

# Preserve the ELF segment alignment of the native libraries bundled in wheels.
override_dh_strip:
	dh_strip -X/site-packages/
